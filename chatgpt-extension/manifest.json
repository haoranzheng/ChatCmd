{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_extensionName__",
  "version": "0.1.12",
  "description": "__MSG_extensionDescription__",
  "permissions": ["tabs", "storage", "scripting", "alarms"],
  "host_permissions": ["https://chatgpt.com/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "web_accessible_resources": [
    { "resources": ["sounds/sound_exe.mp3"], "matches": ["https://chatgpt.com/*"] }
  ],
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": [
        "content-runtime.js", "content-chatgpt-clock.js", "content-chatgpt-render.js",
        "content-chatgpt-ui.js", "content-chatgpt-dom.js", "content-chatgpt-transcript.js",
        "content-chatgpt-observer.js", "content-chatgpt-approval-ui.js", "content-chatgpt-monitor.js",
        "content-chatgpt.js", "compact-protocol.js", "content-chatgpt-compact.js",
        "content-chatgpt-resume.js", "content-chatgpt-native.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*"],
      "js": ["content-runtime.js", "content-chatcmd.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["page-chatgpt-render.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
